#!/usr/bin/env node
/**
 * **A fix to a register row lands with its evidence in its message, or not at all** (2026-11-10). A commit that changes
 * package source (`packages/<name>/src/`) and names a tracked issue (an id such as `D7`) must carry four lines:
 *
 *   Differential: <worlds, sequences, masks lifted> … power: <the pre-fix control and what it showed>
 *   Counts: <instructions / native cycles per engine>          (or `Counts: n/a (<reason>)`)
 *   Bytes: <gzipped before → after>
 *   Landed = measured: <the cmp of the landed production bundle against the counted variant, with its hash>
 *
 * Why: a fix landed on its rows and counts with no differential run, and nothing stopped it but the next run's
 * mask guard. A commit naming no row (tooling, docs) or touching no package source passes untouched.
 *
 * Install once per clone (hooks are not versioned by git): `git config core.hooksPath scripts/hooks`.
 */
import { readFileSync } from 'node:fs';
import { execFileSync } from 'node:child_process';

const message = readFileSync(process.argv[2], 'utf8')
  .split('\n')
  .filter((line) => !line.startsWith('#'))
  .join('\n');
const staged = execFileSync('git', ['diff', '--cached', '--name-only'], { encoding: 'utf8' }).split('\n').filter(Boolean);
const touchesSource = staged.some((file) => /^packages\/[^/]+\/src\//.test(file));
const rows = message.match(/\b[DRQ]\d{1,3}[a-z]?\b/g);
if (!touchesSource || rows === null) process.exit(0);

/** A field's whole text: its line and the wrapped lines after it, up to a blank line or the next `Label:` line. */
const field = (label) => {
  const lines = message.split('\n');
  const at = lines.findIndex((line) => line.startsWith(label));
  if (at === -1) return '';
  let end = at + 1;
  while (end < lines.length && lines[end].trim() !== '' && !/^[A-Z][A-Za-z =]*:/.test(lines[end])) end++;
  return lines.slice(at, end).join(' ');
};
const required = [
  ['Differential:', { test: () => /\bpower\b/i.test(field('Differential:')) }, 'a `Differential:` field naming the run AND its power control ("power: …")'],
  ['Counts:', /^Counts:\s*\S/im, 'a `Counts:` line (or `Counts: n/a (<reason>)`)'],
  ['Bytes:', /^Bytes:\s*\S/im, 'a `Bytes:` line'],
  ['Landed = measured:', /^Landed = measured:\s*\S/im, 'a `Landed = measured:` line with the cmp and its hash'],
];
const missing = required.filter(([, pattern]) => !pattern.test(message));
if (missing.length === 0) process.exit(0);
console.error(`commit-msg: this commit changes package source and names register row(s) ${[...new Set(rows)].join(', ')}, so it needs:`);
for (const [, , why] of missing) console.error(`  - ${why}`);
console.error('(scripts/hooks/commit-msg; a commit naming no row, or touching no package source, is not checked.)');
process.exit(1);
