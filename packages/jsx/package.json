{
  "name": "@verajs/jsx",
  "version": "0.1.3",
  "publishConfig": {
    "access": "public"
  },
  "description": "JSX/TSX for VeraJS as a build plugin: compiles JSX into the renderer\u2019s tagged templates. Zero runtime cost, zero dependencies.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vera-js/vera.git",
    "directory": "packages/jsx"
  },
  "author": "Brian Grider <hello@verajs.com>",
  "homepage": "https://verajs.dev",
  "type": "module",
  "main": "./dist/vera-jsx.min.js",
  "types": "./dist/development/vera-jsx.d.ts",
  "exports": {
    ".": {
      "types": "./dist/development/vera-jsx.d.ts",
      "development": "./dist/development/vera-jsx.js",
      "default": "./dist/vera-jsx.min.js"
    },
    "./standalone": {
      "types": "./dist/development/vera-jsx-standalone.d.ts",
      "development": "./dist/development/vera-jsx-standalone.js",
      "default": "./dist/vera-jsx-standalone.min.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/development/vera-jsx-standalone.js",
    "./dist/vera-jsx-standalone.min.js"
  ],
  "keywords": [
    "verajs",
    "vera",
    "jsx",
    "tsx",
    "vite-plugin",
    "buildless-optional"
  ],
  "filename": "vera-jsx",
  "scripts": {
    "build": "wireit"
  },
  "wireit": {
    "build": {
      "dependencies": [
        "build:development",
        "build:production",
        "build:types"
      ]
    },
    "build:development": {
      "command": "npx rollup -c",
      "clean": "if-file-deleted",
      "env": {
        "MODE": "dev"
      },
      "files": [
        "src/**/*{.js,.ts}",
        "tsconfig.json",
        "../../tsconfig.json",
        "rollup.config.js",
        "../../defaultRollupConfig.js"
      ],
      "output": [
        "dist/development/*.js",
        "dist/development/*.js.map"
      ]
    },
    "build:production": {
      "command": "npx rollup -c",
      "clean": "if-file-deleted",
      "env": {
        "MODE": "prod"
      },
      "files": [
        "src/**/*{.js,.ts}",
        "tsconfig.json",
        "../../tsconfig.json",
        "rollup.config.js",
        "../../defaultRollupConfig.js"
      ],
      "output": [
        "dist/*.min.js",
        "dist/*.min.js.map"
      ]
    },
    "build:types": {
      "command": "npx rollup -c",
      "env": {
        "MODE": "types"
      },
      "files": [
        "src/**/*{.js,.ts}",
        "tsconfig.json",
        "../../tsconfig.json",
        "rollup.config.js",
        "../../defaultRollupConfig.js"
      ],
      "output": [
        "dist/development/*.d.ts",
        "dist/development/*.d.ts.map"
      ]
    }
  }
}
