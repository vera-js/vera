{
  "name": "@verajs/ssr",
  "version": "0.2.1",
  "description": "Vera-native server-side rendering. Node-only, plain ESM, zero dependencies.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vera-js/vera.git",
    "directory": "packages/ssr"
  },
  "author": "Brian Grider <hello@verajs.com>",
  "homepage": "https://verajs.dev",
  "type": "module",
  "main": "./dist/vera/index.js",
  "exports": {
    ".": {
      "types": "./dist/vera/index.d.ts",
      "default": "./dist/vera/index.js"
    }
  },
  "peerDependencies": {
    "@verajs/core": "^0.3.1",
    "@verajs/styles": "^0.1.2"
  },
  "files": [
    "dist",
    "!dist/vera/types.js"
  ],
  "keywords": [
    "ssr",
    "server side rendering",
    "declarative shadow dom",
    "vera",
    "verajs",
    "web components"
  ],
  "publishConfig": {
    "access": "public"
  },
  "types": "./dist/vera/index.d.ts",
  "scripts": {
    "build": "wireit"
  },
  "wireit": {
    "build": {
      "dependencies": [
        "../core:build",
        "../styles:build"
      ],
      "command": "npx tsc -p tsconfig.json",
      "clean": "if-file-deleted",
      "files": [
        "src/**/*.ts",
        "tsconfig.json",
        "../tsconfig/base.json"
      ],
      "output": [
        "dist/**"
      ]
    }
  }
}
