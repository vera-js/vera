{
  "name": "@verajs/ssr",
  "version": "0.1.4",
  "description": "Vera-native server-side rendering. Node-only, plain ESM, zero dependencies.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vera-js/vera.git",
    "directory": "packages/ssr"
  },
  "author": "Brian Grider <hello@verajs.com>",
  "homepage": "https://verajs.dev",
  "type": "module",
  "main": "./src/vera/index.js",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/vera/index.js"
    }
  },
  "peerDependencies": {
    "@verajs/core": "^0.2.1",
    "@verajs/styles": "^0.1.0"
  },
  "files": [
    "src",
    "types"
  ],
  "keywords": [
    "ssr",
    "server side rendering",
    "declarative shadow dom",
    "vera",
    "verajs",
    "web components"
  ],
  "publishConfig": {
    "access": "public"
  },
  "types": "./types/index.d.ts",
  "scripts": {
    "build": "wireit"
  },
  "wireit": {
    "build": {
      "dependencies": [
        "../core:build",
        "../styles:build"
      ],
      "command": "npx tsc -p tsconfig.json --noEmit false --declaration --emitDeclarationOnly --rootDir src/vera --outDir types",
      "clean": "if-file-deleted",
      "files": [
        "src/**/*.js",
        "tsconfig.json",
        "../../tsconfig.json",
        "../tsconfig/base.json"
      ],
      "output": [
        "types/**/*.d.ts"
      ]
    }
  }
}
