{
  "name": "@verajs/ui",
  "version": "0.0.0",
  "private": true,
  "description": "VeraJS components: styled, accessible, form-associated custom elements over @verajs/hooks \u2014 shadow DOM by default, light by attribute, restylable without a fight.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vera-js/vera.git",
    "directory": "packages/ui"
  },
  "author": "Brian Grider <hello@verajs.com>",
  "homepage": "https://verajs.dev",
  "main": "./dist/vera-ui.min.js",
  "types": "./dist/development/vera-ui.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/development/vera-ui.d.ts",
      "development": "./dist/development/vera-ui.js",
      "default": "./dist/vera-ui.min.js"
    },
    "./elements": {
      "types": "./dist/development/vera-ui-elements.d.ts",
      "development": "./dist/development/vera-ui-elements.js",
      "default": "./dist/vera-ui-elements.min.js"
    }
  },
  "peerDependencies": {
    "@verajs/core": ">=0.2.0",
    "@verajs/hooks": ">=0.0.0",
    "@verajs/renderer": ">=0.1.0"
  },
  "files": [
    "dist",
    "custom-elements.json"
  ],
  "customElements": "custom-elements.json",
  "scripts": {
    "build": "wireit",
    "manifest": "node scripts/generate-manifest.mjs",
    "manifest:check": "node scripts/generate-manifest.mjs --check"
  },
  "wireit": {
    "build": {
      "dependencies": [
        "build:development",
        "build:production",
        "build:types"
      ]
    },
    "build:development": {
      "command": "npx rollup -c",
      "clean": "if-file-deleted",
      "env": {
        "MODE": "dev"
      },
      "files": [
        "src/**/*{.js,.ts}",
        "../shared-types/src/**/*{.js,.ts}",
        "tsconfig.json",
        "../../tsconfig.json",
        "rollup.config.js",
        "../../defaultRollupConfig.js"
      ],
      "output": [
        "dist/development/*.js",
        "dist/development/*.js.map"
      ]
    },
    "build:production": {
      "command": "npx rollup -c",
      "clean": "if-file-deleted",
      "env": {
        "MODE": "prod"
      },
      "files": [
        "src/**/*{.js,.ts}",
        "../shared-types/src/**/*{.js,.ts}",
        "tsconfig.json",
        "../../tsconfig.json",
        "rollup.config.js",
        "../../defaultRollupConfig.js"
      ],
      "output": [
        "dist/*.min.js",
        "dist/*.min.js.map"
      ]
    },
    "build:types": {
      "command": "npx rollup -c",
      "env": {
        "MODE": "types"
      },
      "files": [
        "src/**/*{.js,.ts}",
        "../shared-types/src/**/*{.js,.ts}",
        "tsconfig.json",
        "../../tsconfig.json",
        "rollup.config.js",
        "../../defaultRollupConfig.js"
      ],
      "output": [
        "dist/development/*.d.ts",
        "dist/development/*.d.ts.map"
      ]
    }
  },
  "filename": "vera-ui",
  "keywords": [
    "verajs",
    "vera",
    "ui",
    "components",
    "web-components",
    "select"
  ],
  "sideEffects": [
    "./src/index.ts",
    "./dist/vera-ui.min.js",
    "./dist/development/vera-ui.js"
  ]
}
