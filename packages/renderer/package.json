{
  "name": "@verajs/renderer",
  "version": "0.1.4",
  "publishConfig": {
    "access": "public"
  },
  "description": "Reef JS renderer repurposed as lightweight renderer option for use with VeraJS",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vera-js/vera.git",
    "directory": "packages/renderer"
  },
  "author": "Brian Grider <hello@verajs.com>",
  "homepage": "https://verajs.dev",
  "main": "./dist/vera-renderer.min.js",
  "types": "./dist/development/vera-renderer.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/development/vera-renderer.d.ts",
      "development": "./dist/development/vera-renderer.js",
      "default": "./dist/vera-renderer.min.js"
    },
    "./hydrate": {
      "types": "./dist/development/vera-renderer-hydrate.d.ts",
      "development": "./dist/development/vera-renderer-hydrate.js",
      "default": "./dist/vera-renderer-hydrate.min.js"
    },
    "./profiler": {
      "types": "./dist/development/vera-renderer-profiler.d.ts",
      "default": "./dist/development/vera-renderer-profiler.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "wireit"
  },
  "wireit": {
    "build": {
      "dependencies": [
        "build:development",
        "build:production",
        "build:types"
      ]
    },
    "build:development": {
      "command": "npx rollup -c",
      "clean": "if-file-deleted",
      "env": {
        "MODE": "dev"
      },
      "files": [
        "src/**/*{.js,.ts}",
        "tsconfig.json",
        "../../tsconfig.json",
        "rollup.config.js",
        "../../defaultRollupConfig.js"
      ],
      "output": [
        "dist/development/*.js",
        "dist/development/*.js.map"
      ]
    },
    "build:production": {
      "command": "npx rollup -c",
      "clean": "if-file-deleted",
      "env": {
        "MODE": "prod"
      },
      "files": [
        "src/**/*{.js,.ts}",
        "tsconfig.json",
        "../../tsconfig.json",
        "rollup.config.js",
        "../../defaultRollupConfig.js"
      ],
      "output": [
        "dist/*.min.js",
        "dist/*.min.js.map"
      ]
    },
    "build:types": {
      "command": "npx rollup -c",
      "env": {
        "MODE": "types"
      },
      "files": [
        "src/**/*{.js,.ts}",
        "tsconfig.json",
        "../../tsconfig.json",
        "rollup.config.js",
        "../../defaultRollupConfig.js"
      ],
      "output": [
        "dist/development/*.d.ts",
        "dist/development/*.d.ts.map"
      ]
    }
  },
  "filename": "vera-renderer",
  "keywords": [
    "verajs",
    "vera",
    "renderer",
    "templates",
    "web-components",
    "buildless"
  ],
  "sideEffects": [
    "./dist/development/vera-renderer-hydrate.js",
    "./dist/vera-renderer-hydrate.min.js"
  ]
}
