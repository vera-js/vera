{
  "name": "@verajs/renderer",
  "version": "0.3.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "Reef JS renderer repurposed as lightweight renderer option for use with VeraJS",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vera-js/vera.git",
    "directory": "packages/renderer"
  },
  "author": "Brian Grider <hello@verajs.com>",
  "homepage": "https://verajs.dev",
  "main": "./dist/vera-renderer.min.js",
  "types": "./dist/development/vera-renderer.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/development/vera-renderer.d.ts",
      "development": "./dist/development/vera-renderer.js",
      "default": "./dist/vera-renderer.min.js"
    },
    "./hydration": {
      "types": "./dist/development/vera-renderer-hydration.d.ts",
      "development": "./dist/development/vera-renderer-hydration.js",
      "default": "./dist/vera-renderer-hydration.min.js"
    },
    "./keyed": {
      "types": "./dist/development/vera-renderer-keyed.d.ts",
      "development": "./dist/development/vera-renderer-keyed.js",
      "default": "./dist/vera-renderer-keyed.min.js"
    },
    "./native-elements": {
      "types": "./dist/development/vera-renderer-native-elements.d.ts",
      "development": "./dist/development/vera-renderer-native-elements.js",
      "default": "./dist/vera-renderer-native-elements.min.js"
    },
    "./multi-window": {
      "types": "./dist/development/vera-renderer-multi-window.d.ts",
      "development": "./dist/development/vera-renderer-multi-window.js",
      "default": "./dist/vera-renderer-multi-window.min.js"
    },
    "./profiler": {
      "types": "./dist/development/vera-renderer-profiler.d.ts",
      "default": "./dist/development/vera-renderer-profiler.js"
    },
    "./spread": {
      "types": "./dist/development/vera-renderer-spread.d.ts",
      "development": "./dist/development/vera-renderer-spread.js",
      "default": "./dist/vera-renderer-spread.min.js"
    },
    "./tag": {
      "types": "./dist/development/vera-renderer-tag.d.ts",
      "development": "./dist/development/vera-renderer-tag.js",
      "default": "./dist/vera-renderer-tag.min.js"
    },
    "./slots": {
      "types": "./dist/development/vera-renderer-slots.d.ts",
      "development": "./dist/development/vera-renderer-slots.js",
      "default": "./dist/vera-renderer-slots.min.js"
    },
    "./hydrate-slots": {
      "types": "./dist/development/vera-renderer-hydrate-slots.d.ts",
      "development": "./dist/development/vera-renderer-hydrate-slots.js",
      "default": "./dist/vera-renderer-hydrate-slots.min.js"
    },
    "./elements": {
      "types": "./dist/development/vera-renderer-elements.d.ts",
      "development": "./dist/development/vera-renderer-elements.js",
      "default": "./dist/vera-renderer-elements.min.js"
    },
    "./portal": {
      "types": "./dist/development/vera-renderer-portal.d.ts",
      "development": "./dist/development/vera-renderer-portal.js",
      "default": "./dist/vera-renderer-portal.min.js"
    },
    "./until": {
      "types": "./dist/development/vera-renderer-until.d.ts",
      "development": "./dist/development/vera-renderer-until.js",
      "default": "./dist/vera-renderer-until.min.js"
    },
    "./namespaces": {
      "types": "./dist/development/vera-renderer-namespaces.d.ts",
      "development": "./dist/development/vera-renderer-namespaces.js",
      "default": "./dist/vera-renderer-namespaces.min.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "wireit"
  },
  "wireit": {
    "build": {
      "dependencies": [
        "build:development",
        "build:production",
        "build:types"
      ]
    },
    "build:development": {
      "command": "npx rollup -c",
      "clean": "if-file-deleted",
      "env": {
        "MODE": "dev"
      },
      "files": [
        "src/**/*{.js,.ts}",
        "../shared-utils/src/**/*{.js,.ts}",
        "tsconfig.json",
        "../../tsconfig.json",
        "rollup.config.js",
        "../../defaultRollupConfig.js"
      ],
      "output": [
        "dist/development/*.js",
        "dist/development/*.js.map"
      ]
    },
    "build:production": {
      "command": "npx rollup -c",
      "clean": "if-file-deleted",
      "env": {
        "MODE": "prod"
      },
      "files": [
        "src/**/*{.js,.ts}",
        "../shared-utils/src/**/*{.js,.ts}",
        "tsconfig.json",
        "../../tsconfig.json",
        "rollup.config.js",
        "../../defaultRollupConfig.js"
      ],
      "output": [
        "dist/*.min.js",
        "dist/*.min.js.map"
      ]
    },
    "build:types": {
      "command": "npx rollup -c",
      "env": {
        "MODE": "types"
      },
      "files": [
        "src/**/*{.js,.ts}",
        "../shared-utils/src/**/*{.js,.ts}",
        "tsconfig.json",
        "../../tsconfig.json",
        "rollup.config.js",
        "../../defaultRollupConfig.js"
      ],
      "output": [
        "dist/development/*.d.ts",
        "dist/development/*.d.ts.map"
      ]
    }
  },
  "filename": "vera-renderer",
  "keywords": [
    "verajs",
    "vera",
    "renderer",
    "templates",
    "web-components",
    "buildless"
  ],
  "sideEffects": false,
  "peerDependencies": {
    "@verajs/core": "^0.4.0"
  },
  "peerDependenciesMeta": {
    "@verajs/core": {
      "optional": true
    }
  }
}
