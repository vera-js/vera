{
  "name": "@verajs/directives",
  "version": "0.0.0",
  "private": true,
  "description": "Attribute-activated behaviors for markup nobody writes JS for. Registry-based, nothing wired by default, churn-first activation, vera stores underneath.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vera-js/vera.git",
    "directory": "packages/directives"
  },
  "author": "Brian Grider <hello@verajs.com>",
  "homepage": "https://verajs.dev",
  "main": "./dist/vera-directives.min.js",
  "types": "./dist/development/vera-directives.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/development/vera-directives.d.ts",
      "development": "./dist/development/vera-directives.js",
      "default": "./dist/vera-directives.min.js"
    },
    "./core": {
      "types": "./dist/development/vera-directives-core.d.ts",
      "development": "./dist/development/vera-directives-core.js",
      "default": "./dist/vera-directives-core.min.js"
    },
    "./standalone": {
      "types": "./dist/development/vera-directives-standalone.d.ts",
      "development": "./dist/development/vera-directives-standalone.js",
      "default": "./dist/vera-directives-standalone.min.js"
    },
    "./interaction": {
      "types": "./dist/development/vera-directives-interaction.d.ts",
      "development": "./dist/development/vera-directives-interaction.js",
      "default": "./dist/vera-directives-interaction.min.js"
    },
    "./expressions": {
      "types": "./dist/development/vera-directives-expressions.d.ts",
      "development": "./dist/development/vera-directives-expressions.js",
      "default": "./dist/vera-directives-expressions.min.js"
    },
    "./motion": {
      "types": "./dist/development/vera-directives-motion.d.ts",
      "development": "./dist/development/vera-directives-motion.js",
      "default": "./dist/vera-directives-motion.min.js"
    },
    "./remote": {
      "types": "./dist/development/vera-directives-remote.d.ts",
      "development": "./dist/development/vera-directives-remote.js",
      "default": "./dist/vera-directives-remote.min.js"
    },
    "./query": {
      "types": "./dist/development/vera-directives-query.d.ts",
      "development": "./dist/development/vera-directives-query.js",
      "default": "./dist/vera-directives-query.min.js"
    },
    "./sensors": {
      "types": "./dist/development/vera-directives-sensors.d.ts",
      "development": "./dist/development/vera-directives-sensors.js",
      "default": "./dist/vera-directives-sensors.min.js"
    }
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "wireit"
  },
  "wireit": {
    "build": {
      "dependencies": [
        "build:development",
        "build:production",
        "build:types"
      ]
    },
    "build:development": {
      "command": "npx rollup -c",
      "clean": "if-file-deleted",
      "env": {
        "MODE": "dev"
      },
      "files": [
        "src/**/*{.js,.ts}",
        "../shared-types/src/**/*{.js,.ts}",
        "../shared-utils/src/**/*{.js,.ts}",
        "tsconfig.json",
        "../../tsconfig.json",
        "rollup.config.js",
        "../../defaultRollupConfig.js"
      ],
      "output": [
        "dist/development/*.js",
        "dist/development/*.js.map"
      ]
    },
    "build:production": {
      "command": "npx rollup -c",
      "clean": "if-file-deleted",
      "env": {
        "MODE": "prod"
      },
      "files": [
        "src/**/*{.js,.ts}",
        "../shared-types/src/**/*{.js,.ts}",
        "../shared-utils/src/**/*{.js,.ts}",
        "tsconfig.json",
        "../../tsconfig.json",
        "rollup.config.js",
        "../../defaultRollupConfig.js"
      ],
      "output": [
        "dist/*.min.js",
        "dist/*.min.js.map"
      ]
    },
    "build:types": {
      "command": "npx rollup -c",
      "env": {
        "MODE": "types"
      },
      "files": [
        "src/**/*{.js,.ts}",
        "../shared-types/src/**/*{.js,.ts}",
        "../shared-utils/src/**/*{.js,.ts}",
        "tsconfig.json",
        "../../tsconfig.json",
        "rollup.config.js",
        "../../defaultRollupConfig.js"
      ],
      "output": [
        "dist/development/*.d.ts",
        "dist/development/*.d.ts.map"
      ]
    }
  },
  "filename": "vera-directives",
  "keywords": [
    "verajs",
    "vera",
    "directives",
    "interactivity",
    "web-components"
  ],
  "sideEffects": false,
  "bin": {
    "vera-motion-emit": "./bin/motion-emit.mjs"
  }
}
