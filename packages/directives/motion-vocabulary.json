  "presetDefinitions": {
    "fade": {
      "keyframes": {
        "opacity": "0% 0, 100% 1"
      },
      "ease": "ease-out",
      "scroll": "85%",
      "play": 0.6
    },
    "fade-up": {
      "keyframes": {
        "opacity": "0% 0, 100% 1",
        "translate-y": "0% 40px, 100% 0px"
      },
      "ease": "ease-out",
      "scroll": "85%",
      "play": 0.6
    },
    "fade-down": {
      "keyframes": {
        "opacity": "0% 0, 100% 1",
        "translate-y": "0% -40px, 100% 0px"
      },
      "ease": "ease-out",
      "scroll": "85%",
      "play": 0.6
    },
    "fade-left": {
      "keyframes": {
        "opacity": "0% 0, 100% 1",
        "translate-x": "0% 40px, 100% 0px"
      },
      "ease": "ease-out",
      "scroll": "85%",
      "play": 0.6
    },
    "fade-right": {
      "keyframes": {
        "opacity": "0% 0, 100% 1",
        "translate-x": "0% -40px, 100% 0px"
      },
      "ease": "ease-out",
      "scroll": "85%",
      "play": 0.6
    },
    "zoom-in": {
      "keyframes": {
        "opacity": "0% 0, 100% 1",
        "scale": "0% 0.8, 100% 1"
      },
      "ease": "cubic-bezier(0.34, 1.56, 0.64, 1)",
      "scroll": "85%",
      "play": 0.6
    },
    "zoom-out": {
      "keyframes": {
        "opacity": "0% 0, 100% 1",
        "scale": "0% 1.2, 100% 1"
      },
      "ease": "cubic-bezier(0.34, 1.56, 0.64, 1)",
      "scroll": "85%",
      "play": 0.6
    },
    "slide-up": {
      "keyframes": {
        "translate-y": "0% 100px, 100% 0px"
      },
      "ease": "ease-out",
      "scroll": "85%",
      "play": 0.6
    },
    "slide-down": {
      "keyframes": {
        "translate-y": "0% -100px, 100% 0px"
      },
      "ease": "ease-out",
      "scroll": "85%",
      "play": 0.6
    },
    "blur-in": {
      "keyframes": {
        "opacity": "0% 0, 100% 1",
        "blur": "0% 12px, 100% 0px"
      },
      "ease": "ease-out",
      "scroll": "85%",
      "play": 0.6
    }
  }
