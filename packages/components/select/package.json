{
  "name": "@vera-components/select",
  "version": "0.1.0",
  "private": true,
  "description": "VeraJS components: styled, accessible, form-associated custom elements over @vera-hooks/listbox — shadow DOM by default, light by attribute, restylable without a fight.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vera-js/vera.git",
    "directory": "packages/components/select"
  },
  "author": "Brian Grider <hello@verajs.com>",
  "homepage": "https://verajs.dev",
  "main": "./dist/vera-select.min.js",
  "types": "./dist/development/vera-select.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/development/vera-select.d.ts",
      "development": "./dist/development/vera-select.js",
      "default": "./dist/vera-select.min.js"
    },
    "./elements": {
      "types": "./dist/development/vera-select-elements.d.ts",
      "development": "./dist/development/vera-select-elements.js",
      "default": "./dist/vera-select-elements.min.js"
    }
  },
  "peerDependencies": {
    "@verajs/core": "^0.4.1",
    "@verajs/renderer": "^0.3.1"
  },
  "dependencies": {
    "@vera-hooks/listbox": "^0.1.0"
  },
  "files": [
    "dist",
    "custom-elements.json"
  ],
  "customElements": "custom-elements.json",
  "scripts": {
    "build": "wireit",
    "manifest": "node ../../../scripts/generate-cem.mjs packages/components/select",
    "manifest:check": "node ../../../scripts/generate-cem.mjs packages/components/select --check"
  },
  "wireit": {
    "build": {
      "dependencies": [
        "build:development",
        "build:production",
        "build:types"
      ]
    },
    "build:development": {
      "command": "npx rollup -c",
      "clean": "if-file-deleted",
      "env": {
        "MODE": "dev"
      },
      "files": [
        "src/**/*{.js,.ts}",
        "../../shared-types/src/**/*{.js,.ts}",
        "../../shared-utils/src/**/*{.js,.ts}",
        "tsconfig.json",
        "../../../tsconfig.json",
        "rollup.config.js",
        "../../../defaultRollupConfig.js"
      ],
      "output": [
        "dist/development/*.js",
        "dist/development/*.js.map"
      ]
    },
    "build:production": {
      "command": "npx rollup -c",
      "clean": "if-file-deleted",
      "env": {
        "MODE": "prod"
      },
      "files": [
        "src/**/*{.js,.ts}",
        "../../shared-types/src/**/*{.js,.ts}",
        "../../shared-utils/src/**/*{.js,.ts}",
        "tsconfig.json",
        "../../../tsconfig.json",
        "rollup.config.js",
        "../../../defaultRollupConfig.js"
      ],
      "output": [
        "dist/*.min.js",
        "dist/*.min.js.map"
      ]
    },
    "build:types": {
      "command": "npx rollup -c",
      "env": {
        "MODE": "types"
      },
      "files": [
        "src/**/*{.js,.ts}",
        "../../shared-types/src/**/*{.js,.ts}",
        "../../shared-utils/src/**/*{.js,.ts}",
        "tsconfig.json",
        "../../../tsconfig.json",
        "rollup.config.js",
        "../../../defaultRollupConfig.js"
      ],
      "output": [
        "dist/development/*.d.ts",
        "dist/development/*.d.ts.map"
      ],
      "dependencies": [
        "../../hooks/listbox:build:types"
      ]
    }
  },
  "filename": "vera-select",
  "keywords": [
    "verajs",
    "vera",
    "components",
    "web-components",
    "select"
  ],
  "sideEffects": [
    "./src/index.ts",
    "./dist/vera-select.min.js",
    "./dist/development/vera-select.js"
  ]
}
