{
  "name": "@vera-components/menu",
  "version": "0.1.0",
  "private": true,
  "description": "An action menu over the author's own markup: a trigger button and a slot=\"menu\" container of buttons, links, separators and groups, wired in place as a menu button and a popover menu placed by CSS anchor positioning. It opens from the keyboard or the pointer with focus by modality, moves by the arrows and typeahead, handles checkbox and radio items, fires a cancelable menuaction, and in context mode opens at the pointer over its target.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vera-js/vera.git",
    "directory": "packages/components/menu"
  },
  "author": "Brian Grider <hello@verajs.com>",
  "homepage": "https://verajs.dev",
  "type": "module",
  "main": "./dist/vera-menu.min.js",
  "types": "./dist/development/vera-menu.d.ts",
  "exports": {
    ".": {
      "types": "./dist/development/vera-menu.d.ts",
      "development": "./dist/development/vera-menu.js",
      "default": "./dist/vera-menu.min.js"
    },
    "./element": {
      "types": "./dist/development/vera-menu-element.d.ts",
      "development": "./dist/development/vera-menu-element.js",
      "default": "./dist/vera-menu-element.min.js"
    }
  },
  "sideEffects": [
    "./dist/development/vera-menu.js",
    "./dist/vera-menu.min.js"
  ],
  "peerDependencies": {
    "@verajs/core": "^0.5.1"
  },
  "dependencies": {
    "@vera-hooks/roving-focus": "^0.1.0",
    "@vera-hooks/typeahead": "^0.1.0"
  },
  "files": [
    "dist",
    "custom-elements.json"
  ],
  "customElements": "custom-elements.json",
  "scripts": {
    "build": "wireit"
  },
  "wireit": {
    "build": {
      "dependencies": [
        "build:development",
        "build:production",
        "build:types"
      ]
    },
    "build:development": {
      "command": "npx rollup -c",
      "clean": "if-file-deleted",
      "env": {
        "MODE": "dev"
      },
      "files": [
        "src/**/*{.js,.ts}",
        "../../shared-types/src/**/*{.js,.ts}",
        "../../shared-utils/src/**/*{.js,.ts}",
        "tsconfig.json",
        "../../../tsconfig.json",
        "rollup.config.js",
        "../../../defaultRollupConfig.js"
      ],
      "output": [
        "dist/development/*.js",
        "dist/development/*.js.map"
      ]
    },
    "build:production": {
      "command": "npx rollup -c",
      "clean": "if-file-deleted",
      "env": {
        "MODE": "prod"
      },
      "files": [
        "src/**/*{.js,.ts}",
        "../../shared-types/src/**/*{.js,.ts}",
        "../../shared-utils/src/**/*{.js,.ts}",
        "tsconfig.json",
        "../../../tsconfig.json",
        "rollup.config.js",
        "../../../defaultRollupConfig.js"
      ],
      "output": [
        "dist/*.min.js",
        "dist/*.min.js.map"
      ]
    },
    "build:types": {
      "command": "npx rollup -c",
      "env": {
        "MODE": "types"
      },
      "files": [
        "src/**/*{.js,.ts}",
        "../../shared-types/src/**/*{.js,.ts}",
        "../../shared-utils/src/**/*{.js,.ts}",
        "tsconfig.json",
        "../../../tsconfig.json",
        "rollup.config.js",
        "../../../defaultRollupConfig.js"
      ],
      "output": [
        "dist/development/*.d.ts",
        "dist/development/*.d.ts.map"
      ],
      "dependencies": [
        "../../hooks/roving-focus:build:types",
        "../../hooks/typeahead:build:types"
      ]
    }
  },
  "filename": "vera-menu"
}
