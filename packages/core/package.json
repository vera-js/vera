{
  "name": "@verajs/core",
  "version": "0.1.1",
  "publishConfig": {
    "access": "public"
  },
  "description": "A user-friendly JavaScript framework for effortless reactive state and rendering using web components.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vera-js/vera.git",
    "directory": "packages/core"
  },
  "author": "VeraJS",
  "homepage": "https://verajs.dev",
  "main": "./dist/vera.min.js",
  "types": "./dist/development/vera.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/development/vera.d.ts",
      "development": "./dist/development/vera.js",
      "default": "./dist/vera.min.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "wireit"
  },
  "wireit": {
    "build": {
      "dependencies": [
        "build:development",
        "build:production",
        "build:types"
      ]
    },
    "build:development": {
      "command": "npx rollup -c",
      "clean": "if-file-deleted",
      "env": {
        "MODE": "dev"
      },
      "files": [
        "src/**/*{.js,.ts}",
        "../inserts/src/**/*{.js,.ts}",
        "../shared-types/src/**/*{.js,.ts}",
        "../shared-utils/src/**/*{.js,.ts}",
        "tsconfig.json",
        "../../tsconfig.json",
        "rollup.config.js",
        "../../defaultRollupConfig.js"
      ],
      "output": [
        "dist/development/*.js",
        "dist/development/*.js.map"
      ]
    },
    "build:production": {
      "command": "npx rollup -c",
      "clean": "if-file-deleted",
      "env": {
        "MODE": "prod"
      },
      "files": [
        "src/**/*{.js,.ts}",
        "../inserts/src/**/*{.js,.ts}",
        "../shared-types/src/**/*{.js,.ts}",
        "../shared-utils/src/**/*{.js,.ts}",
        "tsconfig.json",
        "../../tsconfig.json",
        "rollup.config.js",
        "../../defaultRollupConfig.js"
      ],
      "output": [
        "dist/*.min.js",
        "dist/*.min.js.map"
      ]
    },
    "build:types": {
      "command": "npx rollup -c",
      "env": {
        "MODE": "types"
      },
      "files": [
        "src/**/*{.js,.ts}",
        "../inserts/src/**/*{.js,.ts}",
        "../shared-types/src/**/*{.js,.ts}",
        "../shared-utils/src/**/*{.js,.ts}",
        "tsconfig.json",
        "../../tsconfig.json",
        "rollup.config.js",
        "../../defaultRollupConfig.js"
      ],
      "output": [
        "dist/development/*.d.ts",
        "dist/development/*.d.ts.map"
      ]
    }
  },
  "filename": "vera",
  "keywords": [
    "verajs",
    "vera",
    "reactive",
    "state",
    "web-components",
    "framework",
    "buildless"
  ],
  "dependencies": {
    "@verajs/inserts": "^0.1.1"
  },
  "sideEffects": true
}
