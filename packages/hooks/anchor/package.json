{
  "name": "@vera-hooks/anchor",
  "version": "0.1.0",
  "private": true,
  "description": "anchor: a headless Vera hook.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vera-js/vera.git",
    "directory": "packages/hooks/anchor"
  },
  "author": "Brian Grider <hello@verajs.com>",
  "homepage": "https://verajs.dev",
  "type": "module",
  "main": "./dist/vera-anchor.min.js",
  "types": "./dist/development/vera-anchor.d.ts",
  "exports": {
    ".": {
      "types": "./dist/development/vera-anchor.d.ts",
      "development": "./dist/development/vera-anchor.js",
      "default": "./dist/vera-anchor.min.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "wireit"
  },
  "wireit": {
    "build": {
      "dependencies": [
        "build:development",
        "build:production",
        "build:types"
      ]
    },
    "build:development": {
      "command": "npx rollup -c",
      "clean": "if-file-deleted",
      "env": {
        "MODE": "dev"
      },
      "files": [
        "src/**/*{.js,.ts}",
        "../../shared-types/src/**/*{.js,.ts}",
        "../../shared-utils/src/**/*{.js,.ts}",
        "tsconfig.json",
        "../../../tsconfig.json",
        "rollup.config.js",
        "../../../defaultRollupConfig.js"
      ],
      "output": [
        "dist/development/*.js",
        "dist/development/*.js.map"
      ]
    },
    "build:production": {
      "command": "npx rollup -c",
      "clean": "if-file-deleted",
      "env": {
        "MODE": "prod"
      },
      "files": [
        "src/**/*{.js,.ts}",
        "../../shared-types/src/**/*{.js,.ts}",
        "../../shared-utils/src/**/*{.js,.ts}",
        "tsconfig.json",
        "../../../tsconfig.json",
        "rollup.config.js",
        "../../../defaultRollupConfig.js"
      ],
      "output": [
        "dist/*.min.js",
        "dist/*.min.js.map"
      ]
    },
    "build:types": {
      "command": "npx rollup -c",
      "env": {
        "MODE": "types"
      },
      "files": [
        "src/**/*{.js,.ts}",
        "../../shared-types/src/**/*{.js,.ts}",
        "../../shared-utils/src/**/*{.js,.ts}",
        "tsconfig.json",
        "../../../tsconfig.json",
        "rollup.config.js",
        "../../../defaultRollupConfig.js"
      ],
      "output": [
        "dist/development/*.d.ts",
        "dist/development/*.d.ts.map"
      ]
    }
  },
  "filename": "vera-anchor"
}
