{
  "name": "@verajs/reactivity",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "Reactivity primitives VeraJS core does not ship: memoised derived values, and more to come. Each reachable on its own subpath so a buildless page loads only what it uses.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vera-js/vera.git",
    "directory": "packages/reactivity"
  },
  "author": "Brian Grider <hello@verajs.com>",
  "homepage": "https://verajs.dev",
  "main": "./dist/vera-reactivity.min.js",
  "types": "./dist/development/vera-reactivity.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/development/vera-reactivity.d.ts",
      "development": "./dist/development/vera-reactivity.js",
      "default": "./dist/vera-reactivity.min.js"
    },
    "./computed": {
      "types": "./dist/development/vera-reactivity-computed.d.ts",
      "development": "./dist/development/vera-reactivity-computed.js",
      "default": "./dist/vera-reactivity-computed.min.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "wireit"
  },
  "wireit": {
    "build": {
      "dependencies": [
        "build:development",
        "build:production",
        "build:types"
      ]
    },
    "build:development": {
      "command": "npx rollup -c",
      "clean": "if-file-deleted",
      "env": {
        "MODE": "dev"
      },
      "files": [
        "src/**/*{.js,.ts}",
        "../shared-types/src/**/*{.js,.ts}",
        "../shared-utils/src/**/*{.js,.ts}",
        "tsconfig.json",
        "../../tsconfig.json",
        "rollup.config.js",
        "../../defaultRollupConfig.js"
      ],
      "output": [
        "dist/development/*.js",
        "dist/development/*.js.map"
      ]
    },
    "build:production": {
      "command": "npx rollup -c",
      "clean": "if-file-deleted",
      "env": {
        "MODE": "prod"
      },
      "files": [
        "src/**/*{.js,.ts}",
        "../shared-types/src/**/*{.js,.ts}",
        "../shared-utils/src/**/*{.js,.ts}",
        "tsconfig.json",
        "../../tsconfig.json",
        "rollup.config.js",
        "../../defaultRollupConfig.js"
      ],
      "output": [
        "dist/*.min.js",
        "dist/*.min.js.map"
      ]
    },
    "build:types": {
      "command": "npx rollup -c",
      "env": {
        "MODE": "types"
      },
      "files": [
        "src/**/*{.js,.ts}",
        "../shared-types/src/**/*{.js,.ts}",
        "../shared-utils/src/**/*{.js,.ts}",
        "tsconfig.json",
        "../../tsconfig.json",
        "rollup.config.js",
        "../../defaultRollupConfig.js"
      ],
      "output": [
        "dist/development/*.d.ts",
        "dist/development/*.d.ts.map"
      ]
    }
  },
  "filename": "vera-reactivity",
  "dependencies": {
    "@verajs/core": "^0.2.1"
  },
  "keywords": [
    "verajs",
    "vera",
    "reactivity",
    "computed",
    "memo",
    "derived",
    "store"
  ],
  "sideEffects": false
}
