{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "posts",
  "type": "object",
  "properties": {
    "uuid": {
      "type": "string",
      "description": "Stable identity, never derived from the path — references key on it."
    },
    "title": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])([T ]([01]\\d|2[0-3]):[0-5]\\d(:[0-5]\\d)?)?$",
      "x-vera-type": "date"
    },
    "tags": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      },
      "x-vera-type": "taxonomy",
      "x-vera-taxonomy": "tags"
    }
  },
  "required": [
    "date"
  ],
  "additionalProperties": true
}
