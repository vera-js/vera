# Logs
logs
*.log
npm-debug.log*

# Dependency directories
**/node_modules/

# Build output
dist/
build/

# Environment variables
.Environment

# Operating system files
.DS_Store
Thumbs.debug

# Wireit
**/.wireit

# Rollup
**/.rollup.cache
# Private notes portal (vera-js/internal) — never committed here
/internal/

# scratch from tests/lifecycle-parity.test.mjs, removed in a finally — this is the crash case
tests/.lifecycle-*

# JSX twins compiled beside their originals by tests/kitchen-jsx.test.mjs, removed in a finally
examples/kitchen-sink/.jsx-*

tests/.scale-*

tests/.styles-*

tests/.location-*

tests/.title-*

tests/.hoist-*

tests/.inserts-*

# Generated from @verajs/ssr's JSDoc at build time — the package publishes src, never .ts
packages/ssr/types/

# Ad-hoc audit probes. Every commit here uses `git add -A`, and a probe named `probe.tmp.mjs`
# was swept into one — so the pattern is ignored rather than remembered.
*.tmp.*
.probe/
