{
  "compilerOptions": {
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "composite": true,
    "inlineSources": true,
    "jsx": "preserve",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noFallthroughCasesInSwitch": true,
    "noImplicitAny": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "outDir": "./dist",
    "rootDir": ".",
    "sourceMap": true,
    "strict": true,
    "stripInternal": true,
    /** `examples/npm-ts` imports a `.tsx` component directly, because its autoloader fetches
        `.ts` and that one file is `.tsx`. Vite resolves it; tsc needs telling. */
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "target": "ES2022",
    "paths": {
      "@vera-components/checkbox": [
        "./packages/components/checkbox/src/register.ts"
      ],
      "@vera-components/checkbox/element": [
        "./packages/components/checkbox/src/index.ts"
      ],
      "@vera-components/dialog": [
        "./packages/components/dialog/src/register.ts"
      ],
      "@vera-components/dialog/element": [
        "./packages/components/dialog/src/index.ts"
      ],
      "@vera-components/menu": [
        "./packages/components/menu/src/register.ts"
      ],
      "@vera-components/menu/element": [
        "./packages/components/menu/src/index.ts"
      ],
      "@vera-hooks/typeahead": [
        "./packages/hooks/typeahead/src/index.ts"
      ],
      "@vera-components/tabs": [
        "./packages/components/tabs/src/register.ts"
      ],
      "@vera-components/tabs/element": [
        "./packages/components/tabs/src/index.ts"
      ],
      "@vera-components/spinner": [
        "./packages/components/spinner/src/register.ts"
      ],
      "@vera-components/spinner/element": [
        "./packages/components/spinner/src/index.ts"
      ],
      "@vera-components/input": [
        "./packages/components/input/src/register.ts"
      ],
      "@vera-components/input/element": [
        "./packages/components/input/src/index.ts"
      ],
      "@vera-components/kbd": [
        "./packages/components/kbd/src/register.ts"
      ],
      "@vera-components/kbd/element": [
        "./packages/components/kbd/src/index.ts"
      ],
      "@vera-components/field": [
        "./packages/components/field/src/register.ts"
      ],
      "@vera-components/field/element": [
        "./packages/components/field/src/index.ts"
      ],
      "@vera-hooks/labeled": [
        "./packages/hooks/labeled/src/index.ts"
      ],
      "@vera-hooks/roving-focus/internal": [
        "./packages/hooks/roving-focus/src/internal.ts"
      ],
      "@vera-hooks/roving-focus": [
        "./packages/hooks/roving-focus/src/index.ts"
      ],
      "@vera-hooks/announce": [
        "./packages/hooks/announce/src/index.ts"
      ],
      "@vera-hooks/anchor": [
        "./packages/hooks/anchor/src/index.ts"
      ],
      "@vera-components/icon": [
        "./packages/components/icon/src/register.ts"
      ],
      "@vera-components/icon/element": [
        "./packages/components/icon/src/index.ts"
      ],
      "@vera-components/select": [
        "./packages/components/select/src/index.ts"
      ],
      "@vera-components/select/elements": [
        "./packages/components/select/src/elements.ts"
      ],
      "@vera-hooks/listbox": [
        "./packages/hooks/listbox/src/index.ts"
      ],
      "@vera-hooks/light-dismiss": [
        "./packages/hooks/light-dismiss/src/index.ts"
      ],
      "@verajs/autoloader": [
        "./packages/autoloader/src/index.ts"
      ],
      "@verajs/core": [
        "./packages/core/src/index.ts"
      ],
      "@verajs/inserts": [
        "./packages/inserts/src/index.ts"
      ],
      "@verajs/motion": [
        "./packages/motion/src/core-entry.ts"
      ],
      "@verajs/motion/core": [
        "./packages/motion/src/core-entry.ts"
      ],
      "@verajs/motion/ssr": [
        "./packages/motion/src/ssr-entry.ts"
      ],
      "@verajs/motion/client": [
        "./packages/motion/src/client-entry.ts"
      ],
      "@verajs/motion/internal": [
        "./packages/motion/src/internal-entry.ts"
      ],
      "@verajs/hot": [
        "./packages/hot/src/index.ts"
      ],
      "@verajs/lite": [
        "./packages/lite/src/index.ts"
      ],
      "@verajs/static": [
        "./packages/static/src/index.ts"
      ],
      "@verajs/renderer": [
        "./packages/renderer/src/index.ts"
      ],
      "@verajs/store": [
        "./packages/store/src/index.ts"
      ],
      "@verajs/renderer/spread": [
        "./packages/renderer/src/spread.ts"
      ],
      "@verajs/renderer/keyed": [
        "./packages/renderer/src/keyed.ts"
      ],
      "@verajs/renderer/slots": [
        "./packages/renderer/src/slots.ts"
      ],
      "@verajs/router": [
        "./packages/router/src/index.ts"
      ],
      "@verajs/styles": [
      "./packages/styles/src/index.ts"
    ],
    "@verajs/shared-types": [
        "./packages/shared-types/src/index.ts"
      ],
      "@verajs/shared-utils": [
        "./packages/shared-utils/src/index.ts"
      ]
    }
  },
  // Inherited by every package tsconfig, which override `include` but not `files`. Declares the
  // `__DEV__` build constant so development-only code type-checks in each package.
  "files": ["./globals.d.ts"],
  "include": [
    "./packages/**/*.ts",
    "./examples/**/*",
    "./tests/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "**/dist",
    "**/.wireit",
    "archive",
    "examples/ssr-node",
    "packages/ssr"
  ]
}
